DEBUG=true
SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=127.0.0.1,localhost

# Premium entitlement
SUBSCRIPTION_TRIAL_DAYS=7

# Cafe Bazaar. The SKU must match the annual subscription created in Pishkhan.
BAZAAR_PACKAGE_NAME=com.hamrahemadar.app
BAZAAR_ANNUAL_SUBSCRIPTION_ID=hamrah_madar_premium_annual

# Local development can use mock verification only while DEBUG=true.
# Production: set BAZAAR_VERIFICATION_MODE=api and provide all three credentials below.
BAZAAR_VERIFICATION_MODE=mock
BAZAAR_CLIENT_ID=
BAZAAR_CLIENT_SECRET=
BAZAAR_REFRESH_TOKEN=

# Google Sign-In backend verification
GOOGLE_OAUTH_CLIENT_IDS=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
